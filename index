    <!-- منطق وبرمجة المتجر الإلكتروني الجانبي والمودال والتفاعلات -->
    <script>
        const productsData = {
            'gt3-black': { name: 'GT3 RS TEE (BLACK)', price: 29.99, img: '1000100982.png' },
            'discipline-black': { name: 'DISCIPLINE TEE (BLACK)', price: 29.99, img: '1000100983.png' },
            'balance-black': { name: 'BALANCE TEE (BLACK)', price: 29.99, img: '1000100984.png' },
            'balance-white': { name: 'BALANCE TEE (WHITE)', price: 29.99, img: '1000100820.jpg' },
            'discipline-white': { name: 'DISCIPLINE TEE (WHITE)', price: 29.99, img: '1000100821.jpg' },
            'gt3-white': { name: 'GT3 RS TEE (WHITE)', price: 29.99, img: '1000100822.jpg' }
        };

        let cart = [];
        let currentSize = 'M';

        function toggleCart() {
            const panel = document.getElementById('cart-panel');
            const overlay = document.getElementById('cart-overlay');
            const sidebar = document.getElementById('cart-sidebar');

            if (panel.classList.contains('-translate-x-full')) {
                sidebar.classList.remove('pointer-events-none');
                panel.classList.remove('-translate-x-full');
                overlay.classList.replace('opacity-0', 'opacity-100');
            } else {
                panel.classList.add('-translate-x-full');
                overlay.classList.replace('opacity-100', 'opacity-0');
                setTimeout(() => sidebar.classList.add('pointer-events-none'), 300);
            }
        }

        function toggleMobileMenu() {
            document.getElementById('mobile-menu').classList.toggle('translate-x-full');
        }

        function openQuickShop(key) {
            const p = productsData[key];
            if (!p) return;

            document.getElementById('modal-product-name').innerText = p.name;
            document.getElementById('modal-product-price').innerText = `${p.price.toFixed(2)} USD`;
            document.getElementById('modal-product-img-container').innerHTML = `<img src="${p.img}" alt="${p.name}" class="w-full h-full object-contain">`;

            currentSize = 'M';
            setupSizeButtons();

            const modal = document.getElementById('quick-shop-modal');
            modal.classList.remove('pointer-events-none', 'opacity-0');
            modal.classList.add('opacity-100');

            document.getElementById('modal-add-btn').onclick = function() {
                addToCart(key, currentSize);
                closeQuickShop();
            };
        }

        function closeQuickShop() {
            const modal = document.getElementById('quick-shop-modal');
            modal.classList.remove('opacity-100');
            modal.classList.add('pointer-events-none', 'opacity-0');
        }

        function setupSizeButtons() {
            document.querySelectorAll('.size-btn').forEach(btn => {
                if (btn.innerText === currentSize) {
                    btn.className = 'size-btn border border-white text-xs py-1 px-3 bg-white text-black font-bold transition-all';
                } else {
                    btn.className = 'size-btn border border-white/30 text-xs py-1 px-3 hover:border-white text-white transition-all';
                }
                btn.onclick = () => { currentSize = btn.innerText; setupSizeButtons(); };
            });
        }

        function addToCart(key, size) {
            const prod = productsData[key];
            const existing = cart.find(item => item.key === key && item.size === size);

            if (existing) {
                existing.qty++;
            } else {
                cart.push({ key, name: prod.name, price: prod.price, size, qty: 1, img: prod.img });
            }
            updateCartUI();
            showToast(`تمت إضافة ${prod.name} بمقاس [${size}] للسلة.`);
        }

        function updateCartUI() {
            const itemsContainer = document.getElementById('cart-items');
            const emptyMsg = document.getElementById('empty-cart-msg');
            const footer = document.getElementById('cart-footer');
            const countBadge = document.getElementById('cart-count');
            
            let totalQty = 0, subtotal = 0;

            if (cart.length === 0) {
                emptyMsg.style.display = 'flex';
                footer.classList.add('hidden');
                itemsContainer.innerHTML = '';
            } else {
                emptyMsg.style.display = 'none';
                footer.classList.remove('hidden');
                
                itemsContainer.innerHTML = cart.map((item, index) => {
                    totalQty += item.qty;
                    subtotal += (item.price * item.qty);
                    return `
                        <div class="flex items-center gap-4 bg-white/5 p-3 rounded border border-white/5">
                            <img src="${item.img}" class="w-14 h-14 object-contain bg-black/20 p-1 rounded">
                            <div class="flex-1">
                                <h4 class="text-[11px] font-bold tracking-wider">${item.name}</h4>
                                <div class="text-[10px] text-brand-lightGray">المقاس: ${item.size}</div>
                                <div class="flex items-center justify-between mt-2">
                                    <div class="flex items-center gap-2 border border-white/10 px-2 py-0.5 rounded">
                                        <button onclick="changeQty(${index}, -1)" class="text-xs text-brand-lightGray hover:text-white">-</button>
                                        <span class="text-xs font-semibold">${item.qty}</span>
                                        <button onclick="changeQty(${index}, 1)" class="text-xs text-brand-lightGray hover:text-white">+</button>
                                    </div>
                                    <span class="text-xs font-bold">${(item.price * item.qty).toFixed(2)} USD</span>
                                </div>
                            </div>
                        </div>`;
                }).join('');
            }
            countBadge.innerText = totalQty;
            document.getElementById('cart-subtotal').innerText = `${subtotal.toFixed(2)} USD`;
        }

        function changeQty(index, amount) {
            cart[index].qty += amount;
            if (cart[index].qty <= 0) cart.splice(index, 1);
            updateCartUI();
        }

        function showToast(msg) {
            const toast = document.getElementById('toast');
            document.getElementById('toast-message').innerText = msg;
            toast.classList.replace('translate-y-20', 'translate-y-0');
            toast.classList.replace('opacity-0', 'opacity-100');
            setTimeout(() => {
                toast.classList.replace('translate-y-0', 'translate-y-20');
                toast.classList.replace('opacity-100', 'opacity-0');
            }, 3000);
        }

        function checkout() {
            alert('تمت محاكاة طلبك بنجاح! شكراً لك.');
            cart = []; updateCartUI(); toggleCart();
        }
    </script>
</body>
</html>
